+/* Preflight uses safe Mach VM reads before interpreting any load command.
+ * It returns only local prepared values: no hook/state/thread/socket writes. */
+typedef struct {
+    const struct mach_header *header;
+    void *publicTargets[MacWSVNCSymbolCount];
+    void *cgWidth, *cgHeight;
+    Method methods[5];
+    IMP implementations[5];
+    ptrdiff_t modifiersOffset;
+} MacWSVNCPrepared;
+
+static BOOL macws_vnc_memory_range(uintptr_t start,size_t length,
+                                  vm_prot_t required,BOOL forbidWrite) {
+    if (!length || start > UINTPTR_MAX-length) return NO;
+    uintptr_t cursor=start, end=start+length;
+    for (unsigned regions=0;cursor<end && regions<128;regions++) {
+        mach_vm_address_t address=cursor;
+        mach_vm_size_t size=0;
+        vm_region_basic_info_data_64_t info={0};
+        mach_msg_type_number_t count=VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t object=MACH_PORT_NULL;
+        kern_return_t kr=mach_vm_region(mach_task_self(),&address,&size,
+            VM_REGION_BASIC_INFO_64,(vm_region_info_t)&info,&count,&object);
+        if (object != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(),object);
+        if (kr != KERN_SUCCESS || !size || address>cursor ||
+            address>UINT64_MAX-size || address+size<=cursor ||
+            (info.protection & required)!=required ||
+            (forbidWrite && (info.protection & VM_PROT_WRITE))) return NO;
+        cursor=(uintptr_t)(address+size<end ? address+size : end);
+    }
+    return cursor==end;
+}
+
+static BOOL macws_vnc_safe_read(const void *source,void *destination,size_t size) {
+    if (!macws_vnc_memory_range((uintptr_t)source,size,VM_PROT_READ,NO)) return NO;
+    mach_vm_size_t copied=0;
+    return mach_vm_read_overwrite(mach_task_self(),(mach_vm_address_t)source,
+        size,(mach_vm_address_t)destination,&copied)==KERN_SUCCESS && copied==size;
+}
+
+static uint8_t *macws_vnc_copy_commands(const struct mach_header *header,
+                                        size_t *length) {
+    struct mach_header_64 local={0};
+    if (!header || !length || !macws_vnc_safe_read(header,&local,sizeof(local)) ||
+        local.magic!=MH_MAGIC_64 || !local.ncmds || local.ncmds>128 ||
+        !local.sizeofcmds || local.sizeofcmds>65536) return NULL;
+    *length=sizeof(local)+local.sizeofcmds;
+    uint8_t *copy=malloc(*length);
+    if (copy && !macws_vnc_safe_read(header,copy,*length)) {
+        free(copy); copy=NULL;
+    }
+    return copy;
+}
+
+static void *macws_vnc_code_address(const void *pointer) {
+#if __has_feature(ptrauth_calls)
+    return ptrauth_strip((void *)pointer,ptrauth_key_function_pointer);
+#else
+    return (void *)pointer;
+#endif
+}
+
+static BOOL macws_vnc_main_target(const MacWSVNCPrepared *prepared,
+        const MacWSVNCImageProfile *profile,const void *pointer,
+        uint64_t offset,size_t extent,BOOL code) {
+    void *address=code ? macws_vnc_code_address(pointer) : (void *)pointer;
+    uintptr_t base=(uintptr_t)prepared->header, target=(uintptr_t)address;
+    Dl_info owner={0};
+    return address && target>=base && target-base==offset &&
+        macws_vnc_target_offset(profile,offset,extent,code) &&
+        dladdr(address,&owner) && owner.dli_fbase==(void *)prepared->header &&
+        macws_vnc_memory_range(target,extent,
+            code ? (VM_PROT_READ|VM_PROT_EXECUTE) : (VM_PROT_READ|VM_PROT_WRITE),code);
+}
+
+/* Standard CoreGraphics API endpoints also need a real provider and RX
+ * mapping. Their SDK ABI is stable; they do not use the main-image profile. */
+static BOOL macws_vnc_cg_api(void *pointer,const char *symbol,void **ownerOut) {
+    void *address=macws_vnc_code_address(pointer);
+    Dl_info owner={0};
+    if (!address || !dladdr(address,&owner) || !owner.dli_fbase ||
+        !owner.dli_fname || !owner.dli_sname || strcmp(owner.dli_sname,symbol) ||
+        macws_vnc_code_address(owner.dli_saddr)!=address ||
+        !strstr(owner.dli_fname,"/CoreGraphics.framework/") ||
+        strcmp(strrchr(owner.dli_fname,'/') ?: owner.dli_fname,"/CoreGraphics") ||
+        !macws_vnc_memory_range((uintptr_t)address,32,
+                               VM_PROT_READ|VM_PROT_EXECUTE,YES)) return NO;
+    size_t length=0;
+    uint8_t *copy=macws_vnc_copy_commands(owner.dli_fbase,&length);
+    if (!copy) return NO;
+    const struct mach_header_64 *header=(const struct mach_header_64 *)copy;
+    BOOL valid=header->filetype==MH_DYLIB && header->cputype==CPU_TYPE_ARM64;
+    BOOL inCode=NO;
+    size_t cursor=sizeof(*header);
+    for (uint32_t i=0;valid && i<header->ncmds;i++) {
+        if (length-cursor<sizeof(struct load_command)) { valid=NO; break; }
+        const struct load_command *cmd=(const struct load_command *)(copy+cursor);
+        if (cmd->cmdsize<8 || (cmd->cmdsize & 7) || cmd->cmdsize>length-cursor) {
+            valid=NO; break;
+        }
+        if (cmd->cmd==LC_SEGMENT_64) {
+            if (cmd->cmdsize<sizeof(struct segment_command_64)) { valid=NO; break; }
+            const struct segment_command_64 *seg=(const void *)cmd;
+            if (seg->vmaddr>UINT64_MAX-seg->vmsize ||
+                seg->nsects>(cmd->cmdsize-sizeof(*seg))/sizeof(struct section_64)) {
+                valid=NO; break;
+            }
+            const struct section_64 *sections=(const void *)(seg+1);
+            for (uint32_t j=0;j<seg->nsects;j++) {
+                const struct section_64 *s=sections+j;
+                if (!(s->flags & (S_ATTR_PURE_INSTRUCTIONS|S_ATTR_SOME_INSTRUCTIONS)) ||
+                    !(seg->initprot & VM_PROT_EXECUTE)) continue;
+                intptr_t slide=0;
+                BOOL found=NO;
+                for (uint32_t k=0;k<_dyld_image_count();k++) {
+                    if (_dyld_get_image_header(k)==owner.dli_fbase) {
+                        slide=_dyld_get_image_vmaddr_slide(k); found=YES; break;
+                    }
+                }
+                uint64_t actual=(uint64_t)((uintptr_t)owner.dli_fbase);
+                if (!found || s->addr<seg->vmaddr || s->size>seg->vmsize ||
+                    s->addr-seg->vmaddr>seg->vmsize-s->size ||
+                    (slide>=0 && s->addr>UINT64_MAX-(uint64_t)slide) ||
+                    (slide<0 && s->addr<(uint64_t)(-(slide+1))+1)) continue;
+                actual=slide>=0 ? s->addr+(uint64_t)slide
+                               : s->addr-((uint64_t)(-(slide+1))+1);
+                if (macws_vnc_span((uintptr_t)address,32,actual,s->size)) inCode=YES;
+            }
+        }
+        cursor+=cmd->cmdsize;
+    }
+    valid=valid && cursor==length && inCode;
+    free(copy);
+    if (valid && ownerOut) *ownerOut=owner.dli_fbase;
+    return valid;
+}
