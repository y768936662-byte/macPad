+static BOOL macws_vnc_method_types(Method method,unsigned int count,
+                                    const char *const *arguments) {
+    if (!method || method_getNumberOfArguments(method)!=count) return NO;
+    char *returnType=method_copyReturnType(method);
+    BOOL valid=returnType && strcmp(returnType,"v")==0;
+    free(returnType);
+    for (unsigned i=0;valid && i<count;i++) {
+        char *type=method_copyArgumentType(method,i);
+        valid=type && strcmp(type,arguments[i])==0;
+        free(type);
+    }
+    return valid;
+}
